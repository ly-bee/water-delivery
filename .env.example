# HydroFlow Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file to GitHub

# ─────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────
# POSTGRESQL (Primary Database)
# ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hydroflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# ─────────────────────────────────────────
# MONGODB (Sensor Data)
# ─────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/hydroflow_sensors

# ─────────────────────────────────────────
# AUTHENTICATION
# ─────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_minimum_32_chars
JWT_EXPIRES_IN=7d

# IoT Device authentication key (sent by simulator/ESP32)
IOT_DEVICE_API_KEY=replace_with_random_device_key

# ─────────────────────────────────────────
# M-PESA DARAJA API (Safaricom)
# Get credentials from: https://developer.safaricom.co.ke/
# ─────────────────────────────────────────
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey_here
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/callback

# ─────────────────────────────────────────
# AFRICA'S TALKING (SMS)
# Get credentials from: https://africastalking.com/
# ─────────────────────────────────────────
AT_API_KEY=your_africastalking_api_key_here
AT_USERNAME=sandbox
AT_SENDER_ID=HydroFlow

# ─────────────────────────────────────────
# GOOGLE MAPS
# Get API key from: https://console.cloud.google.com/
# ─────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─────────────────────────────────────────
# CLOUDINARY (Proof of delivery photo/signature storage)
# Get credentials from: https://console.cloudinary.com/
# ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ─────────────────────────────────────────
# FRONTEND (React Dashboard)
# ─────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
